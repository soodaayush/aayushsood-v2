# Copy to .env.local and fill in. These are the Firebase web app settings
# (Firebase console -> Project settings -> Your apps). They are used for the
# blog post view and like counters. They are public by design (NEXT_PUBLIC_),
# so access is controlled by your Firestore security rules, not by hiding them.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
