{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "aayushsood-v2",
	"compatibility_date": "2026-08-05",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "aayushsood-v2"
		}
	]
	// Optional, not yet configured for this project:
	// - R2 incremental cache (requires creating an R2 bucket first)
	//   see https://opennext.js.org/cloudflare/caching
	// - Image optimization binding (requires enabling Cloudflare Images)
	//   see https://opennext.js.org/cloudflare/howtos/image
}
